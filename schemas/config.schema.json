{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mackes.invalid/schema/config.schema.json",
  "title": "MACKES configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "settings", "endpoints", "projects", "profiles"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "settings": { "$ref": "#/$defs/settings" },
    "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
    "setlists": { "type": "array", "items": { "$ref": "#/$defs/setlist" } },
    "learned_mappings": { "type": "array", "items": { "$ref": "#/$defs/learned_mapping" } }
  },
  "$defs": {
    "settings": { "type": "object", "additionalProperties": false, "properties": { "active_project": { "type": ["string", "null"] }, "active_scene": { "type": ["string", "null"] }, "learn_input_alias": { "type": ["string", "null"] }, "dashboard_midi_bindings": { "type": "array", "items": { "$ref": "#/$defs/dashboard_midi_binding" } } } },
    "dashboard_midi_binding": { "type": "object", "additionalProperties": false, "required": ["trigger", "command"], "properties": { "trigger": { "$ref": "#/$defs/dashboard_midi_trigger" }, "command": { "enum": ["panic", "next_scene", "previous_scene"] } } },
    "dashboard_midi_trigger": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["kind", "channel", "note"], "properties": { "kind": { "const": "note_on" }, "channel": { "type": "integer", "minimum": 1, "maximum": 16 }, "note": { "type": "integer", "minimum": 0, "maximum": 127 } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "channel", "controller", "value"], "properties": { "kind": { "const": "control_change" }, "channel": { "type": "integer", "minimum": 1, "maximum": 16 }, "controller": { "type": "integer", "minimum": 0, "maximum": 127 }, "value": { "type": ["integer", "null"], "minimum": 0, "maximum": 127 } } } ] },
    "endpoint": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": ["string", "null"] }, "vendor_id": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 }, "product_id": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 }, "serial": { "type": ["string", "null"] } } },
    "project": { "type": "object", "additionalProperties": false, "required": ["id", "scenes"], "properties": { "id": { "type": "string", "minLength": 1 }, "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } } } },
    "scene": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": ["string", "null"] }, "category": { "type": ["string", "null"] } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 } } },
    "setlist": { "type": "object", "additionalProperties": false, "required": ["id", "projects"], "properties": { "id": { "type": "string", "minLength": 1 }, "projects": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "learned_mapping": { "type": "object", "additionalProperties": false, "required": ["source_alias", "message_kind", "channel_policy", "number", "raw", "destination", "mode", "enabled", "priority"], "properties": { "source_alias": { "type": "string", "minLength": 1 }, "message_kind": { "type": "string" }, "channel_policy": {}, "number": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 }, "raw": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }, "destination": { "type": "string", "minLength": 1 }, "mode": { "type": "string" }, "enabled": { "type": "boolean" }, "priority": { "type": "integer", "minimum": 0, "maximum": 65535 }, "filters": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/learned_filter" } } } },
    "learned_filter": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["kind", "minimum", "maximum"], "properties": { "kind": { "const": "number_range" }, "minimum": { "type": "integer", "minimum": 0, "maximum": 127 }, "maximum": { "type": "integer", "minimum": 0, "maximum": 127 } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "minimum", "maximum"], "properties": { "kind": { "const": "value_range" }, "minimum": { "type": "integer", "minimum": 0, "maximum": 16383 }, "maximum": { "type": "integer", "minimum": 0, "maximum": 16383 } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "message"], "properties": { "kind": { "const": "realtime" }, "message": { "enum": ["clock", "start", "continue", "stop", "active_sensing", "reset"] } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "pattern", "mask"], "properties": { "kind": { "const": "sys_ex_mask" }, "pattern": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "type": "integer", "minimum": 0, "maximum": 127 } }, "mask": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "type": "integer", "minimum": 0, "maximum": 127 } } } } ] }
  }
}
