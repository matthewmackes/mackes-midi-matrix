{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mackes.invalid/schema/capability-boundary.schema.json",
  "title": "MACKES versioned capability boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "capabilities"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generation": { "type": "integer", "minimum": 0 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "operations"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "state": { "type": "string", "enum": ["available", "degraded", "unavailable", "unsupported"] },
          "operations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 96 } },
          "read_only": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
